{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trt-rtx-agent/rc-decision.schema.json",
  "title": "ORT release-candidate semantic decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_snapshot_sha256",
    "issue",
    "decision",
    "release",
    "evidence",
    "candidate_artifacts",
    "selected_artifacts",
    "ambiguities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number", "url", "updated_at"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_release_candidate", "disposition", "confidence", "reasoning"],
      "properties": {
        "is_release_candidate": {
          "type": "boolean"
        },
        "disposition": {
          "enum": ["actionable", "watch", "needs_human_review", "not_rc"]
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["version", "candidate_revision"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "candidate_revision": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "candidate_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "selected_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "summary"],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "ecosystem",
        "published_url",
        "target_os",
        "architecture",
        "role",
        "selection_reason",
        "limitations",
        "evidence_urls"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ecosystem": {
          "type": "string",
          "minLength": 1
        },
        "published_url": {
          "type": "string",
          "format": "uri"
        },
        "download_url": {
          "type": "string",
          "format": "uri"
        },
        "target_os": {
          "type": ["string", "null"]
        },
        "architecture": {
          "type": ["string", "null"]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "selection_reason": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
